NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kalpanika?retryWrites=true&w=majority
MONGODB_DB=kalpanika
# For test data, use MONGODB_DB=kalpanika_dev and ALLOW_DEV_SEED=true, then run npm run seed.
ALLOW_DEV_SEED=false
# User data migration is dry-run by default; set true only when intentionally applying it.
ALLOW_DATA_MIGRATION=false
# Preview: npm run migrate:user-data -- --dry-run
# Stage: npm run migrate:user-data -- --apply
# Cut over after reviewing the verified stage: npm run migrate:user-data -- --apply --confirm-cutover

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/account
ADMIN_BOOTSTRAP_EMAILS=you@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional public destination displayed on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional dedicated secret for hashing public-form rate-limit identifiers. Falls back to existing server secrets.
SUPPORT_RATE_LIMIT_SECRET=
# Generate with a cryptographically secure random value of at least 32 characters.
NEWSLETTER_TOKEN_SECRET=
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=Kalpanika
# Required in production before any real email is sent.
NEWSLETTER_ENABLE_REAL_DELIVERY=false
# Required outside production; all email is routed to this one safe test inbox.
NEWSLETTER_TEST_RECIPIENT=
CRON_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
